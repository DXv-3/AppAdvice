# ============================================
# AppAdvice System - Environment Variables
# ============================================

# Copy this file to .env and fill in your values

# --------------------------------------------
# Database
# --------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/appadvice

# --------------------------------------------
# Redis (for caching & queues)
# --------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------
# Pinecone Vector Database
# Get from: https://app.pinecone.io
# --------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=app-advice
PINECONE_NAMESPACE=apps

# --------------------------------------------
# OpenAI (for embeddings)
# Get from: https://platform.openai.com
# --------------------------------------------
OPENAI_API_KEY=your_openai_api_key
EMBEDDING_MODEL=text-embedding-3-small

# --------------------------------------------
# Authentication
# Generate with: openssl rand -hex 32
# --------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --------------------------------------------
# Email (Resend)
# Get from: https://resend.com
# --------------------------------------------
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=alerts@appadvice.com

# --------------------------------------------
# Stripe (for payments)
# Get from: https://stripe.com/dashboard
# --------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PREMIUM=price_...

# --------------------------------------------
# Scraping Configuration
# --------------------------------------------
SCRAPE_INTERVAL_MINUTES=15
MAX_CONCURRENT_SCRAPES=5

# --------------------------------------------
# Frontend URL (for CORS)
# --------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
